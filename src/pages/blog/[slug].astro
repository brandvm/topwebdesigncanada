---
import {render,type CollectionEntry} from 'astro:content';
import Page from '../../layouts/Page.astro';
import GuideCard from '../../components/GuideCard.astro';
import {articles,href,withBase} from '../../lib/content';
import site from '../../data/site.json';
import manifest from '../../../docs/content-manifest.json';
export async function getStaticPaths(){return (await articles()).map(post=>({params:{slug:post.data.slug},props:{post}}))}
interface Props{post:CollectionEntry<'articles'>}
const {post}=Astro.props;
const {Content}=await render(post);
const source=manifest.articles.find(a=>a.slug===post.data.slug)!;
const related=(await articles()).filter(p=>p.id!==post.id);
const publicSite=new URL('https://'+site.domain+'/');
const canonical=new URL('/blog/'+post.data.slug+'/',publicSite).href;
const readingTime=Math.ceil((post.body||'').split(/\s+/).length/220);
const toc=source.anchors.filter(a=>!a.id.startsWith('agency-')&&!/^\d/.test(a.id));
const schema=[{'@type':'BlogPosting','@id':canonical+'#article',headline:post.data.title,description:post.data.description,mainEntityOfPage:canonical,inLanguage:'en',publisher:{'@id':`${publicSite}#publisher`},...(post.data.author?{author:{'@type':'Person',name:post.data.author}}:{}),...(post.data.publishedAt?{datePublished:post.data.publishedAt.toISOString()}:{}),...(post.data.updatedAt?{dateModified:post.data.updatedAt.toISOString()}:{}),image:new URL('/social.png',publicSite).href},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:publicSite.href},{'@type':'ListItem',position:2,name:'Guides',item:new URL('/blog/',publicSite).href},{'@type':'ListItem',position:3,name:post.data.title,item:canonical}]},{'@type':'ItemList',name:post.data.title,itemListElement:source.anchors.filter(a=>a.id.startsWith('agency-')).map((a,i)=>({'@type':'ListItem',position:i+1,name:a.label.replace(/^\d+\s*[.|]\s*/,''),url:canonical+'#'+a.id}))}];
---
<Page title={post.data.title} description={post.data.description} schema={schema} pageId={href(post.data.slug)}>
<nav aria-label="Breadcrumb"><ol class="breadcrumbs"><li><a href={withBase("/")}>Home</a></li><li aria-hidden="true">/</li><li><a href={withBase("/blog/")}>Guides</a></li><li aria-hidden="true">/</li><li aria-current="page">{post.data.topic}</li></ol></nav>
<article><header class="article-header" data-review-anchor="article-header"><p class="eyebrow">THE GUIDE / {post.data.topic}</p><h1>{post.data.title}</h1><div class="article-meta"><span>2026 edition</span><span>10 agencies compared</span><span>{readingTime} min read</span>{post.data.updatedAt&&<time datetime={post.data.updatedAt.toISOString()}>Updated {post.data.updatedAt.toLocaleDateString('en-CA',{timeZone:'UTC'})}</time>}</div></header>
<div class="article-grid"><aside class="toc" aria-label="Article contents" data-review-anchor="contents"><h2>In this guide</h2><ol>{toc.map(h=><li><a href={`#${h.id}`}>{h.label.replace(/:.*$/,'')}</a></li>)}</ol><a class="back-top" href="#top">Back to top ↑</a></aside><div class="prose" data-source-article={post.data.slug}><Content/></div></div></article>
{related.length>0&&<section class="section article-end" aria-label="Related guides" data-review-anchor="related-guides"><div class="section-head"><h2>Another perspective.</h2><a class="inline-link" href={withBase("/blog/")}>All guides ↗</a></div><div class="guide-grid">{related.map((p,i)=><GuideCard post={p} index={i}/>)}</div></section>}
</Page>
