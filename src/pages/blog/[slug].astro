---
import type {CollectionEntry} from 'astro:content';import Article from '../../components/Article.astro';import {articles} from '../../lib/content';import site from '../../data/site.json';
export async function getStaticPaths(){return (await articles()).filter(post=>post.data.slug!==site.homeArticle).map(post=>({params:{slug:post.data.slug},props:{post}}))}
interface Props{post:CollectionEntry<'articles'>}
const {post}=Astro.props;
---
<Article post={post}/>
