---
import Page from '../layouts/Page.astro';import Feature from '../components/Feature.astro';import GuideCard from '../components/GuideCard.astro';import Cover from '../components/Cover.astro';import Icon from '../components/Icon.astro';import AgencyIndex from '../components/AgencyIndex.astro';import Approach from '../components/Approach.astro';
import site from '../data/site.json';import {articles,href,withBase} from '../lib/content';
const posts=await articles();const featured=posts[0];
---
<Page>
<section class="hero canada-hero" data-review-anchor="hero"><div><p class="eyebrow">A Canadian perspective on web design</p><h1>Find your next<br><em>digital partner.</em></h1><p class="intro">Good work happens everywhere. Explore web design agencies across Canada, with a closer look at the teams shaping Toronto’s digital landscape.</p><div class="actions"><a class="button" href={withBase("/blog/")}>Explore the guides <Icon name="arrow-up-right"/></a><a class="text-link" href="#our-approach">Our approach</a></div></div><Cover eager/></section><div class="canada-topics"><p>EXPLORE BY LOCATION</p><nav class="topic-nav" aria-label="Geographic guides">{posts.map(p=><a href={href(p.data.slug)}><Icon name="map-pin"/>{p.data.slug.includes("toronto")?"Toronto":"Across Canada"}</a>)}</nav></div><section class="section" data-review-anchor="guides"><div class="section-head"><div><p class="eyebrow">The reading list</p><h2>Your market. Your next move.</h2></div><a class="text-link" href={withBase("/blog/")}>All guides <Icon name="arrow-up-right"/></a></div><div class="guide-grid">{posts.map((post,index)=><GuideCard post={post} index={index}/>)}</div>{posts.length===0&&<p>No guides are published yet.</p>}</section><section class="section" data-review-anchor="agency-shortlist"><div class="index-head"><div><p class="eyebrow">Inside the guide</p><h2>Start your shortlist.</h2></div></div>{featured&&<AgencyIndex slug={featured.data.slug}/>}<p class="small" style="margin-top:20px">The first three agencies in the guide. Read the full comparison for rankings, qualifications, and methodology.</p></section><Approach/></Page>
