---
import Article from '../components/Article.astro';import Page from '../layouts/Page.astro';import {articles,withBase} from '../lib/content';import site from '../data/site.json';
const post=(await articles()).find(p=>p.data.slug===site.homeArticle);
---
{post?<Article post={post}/>:<Page><section class="hero"><h1>{site.name}</h1><p>Our agency guide is being prepared.</p><a href={withBase('/blog/')}>Browse available comparisons</a></section></Page>}
