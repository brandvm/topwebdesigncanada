---
import {href} from '../lib/content';
import Cover from './Cover.astro';import Icon from './Icon.astro';
import type {CollectionEntry} from 'astro:content';
interface Props{post:CollectionEntry<'articles'>;index?:number;heading?:'h2'|'h3'}
const {post,index=0,heading:Heading='h3'}=Astro.props;
---
<a class="guide-card" href={href(post.data.slug)} data-review-anchor={`guide-${post.data.slug}`}>
<Cover slug={post.data.slug}/><span class="eyebrow">{post.data.topic}</span><Heading>{post.data.title}</Heading><p>{post.data.description}</p><span class="card-foot"><span>10 agencies · 2026 guide</span><Icon name="arrow-up-right"/></span>
</a>
