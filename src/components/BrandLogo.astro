---
import {withBase} from '../lib/content';
---
<picture class="brand-logo">
  <source media="(max-width: 540px)" srcset={withBase('/brand/logo-compact.svg')} width="242" height="76"/>
  <img src={withBase('/wordmark.svg')} width="283" height="84" alt="" loading="eager" decoding="sync"/>
</picture>
<style>
  .brand-logo { display: block; width: 202.143px; max-width: 100%; }
  .brand-logo img { display: block; width: 100%; height: auto; }
  @media (max-width: 540px) {
    .brand-logo { width: 165.579px; }
    .brand-logo img { aspect-ratio: 242 / 76; }
  }
</style>
