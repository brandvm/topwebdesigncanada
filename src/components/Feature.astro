---
import {href} from '../lib/content';import Cover from './Cover.astro';import Icon from './Icon.astro';
import type {CollectionEntry} from 'astro:content';
interface Props{post?:CollectionEntry<'articles'>}
const {post}=Astro.props;
---
{post&&<article class="feature-story" data-review-anchor="guide-feature"><Cover slug={post.data.slug} label="Featured guide"/><div class="feature-copy"><p class="eyebrow">In focus / {post.data.topic}</p><h2><a href={href(post.data.slug)}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={href(post.data.slug)}>Explore the full guide <Icon name="arrow-up-right"/></a></div></article>}
