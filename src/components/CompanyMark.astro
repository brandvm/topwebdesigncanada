---
import marks from '../data/agency-marks.json';import {withBase} from '../lib/content';
interface Props{id:string;name:string;decorative?:boolean;}
const {id,name,decorative=false}=Astro.props;const mark=(marks as Record<string,string>)[id];
const initials=name.replace(/[^a-zA-Z0-9 ]/g,'').split(/\s+/).slice(0,2).map(s=>s[0]).join('');
---
<span class="company-mark" aria-hidden={decorative?'true':undefined}>{mark?<img src={withBase('/images/agencies/'+mark)} width="100" height="45" alt={`${name} logo`} loading="lazy" decoding="async"/>:<span class="initials" aria-hidden="true">{initials}</span>}</span>
