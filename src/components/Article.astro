---
import {render,type CollectionEntry} from 'astro:content';
import Page from '../layouts/Page.astro';
import GuideCard from './GuideCard.astro';import CompanyMark from './CompanyMark.astro';import Icon from './Icon.astro';
import {articles,href,withBase} from '../lib/content';
import site from '../data/site.json';import manifest from '../../docs/content-manifest.json';
interface Props{post:CollectionEntry<'articles'>}
const {post}=Astro.props;const {Content}=await render(post);
const source=manifest.articles.find(a=>a.slug===post.data.slug)!;
const allRankings=import.meta.glob('../data/rankings/*.json',{eager:true,import:'default'});
const ranking=allRankings[`../data/rankings/${post.data.slug}.json`] as {agencies:{id:string;name:string;cells:string[]}[]};
const related=(await articles()).filter(p=>p.id!==post.id);
const publicSite=new URL('https://'+site.domain+'/');const canonical=new URL(href(post.data.slug),publicSite).href;
const isHome=post.data.slug===site.homeArticle;const readingTime=Math.ceil((post.body||'').split(/\s+/).length/220);
const toc=source.anchors.filter(a=>!a.id.startsWith('agency-')&&!/^\d/.test(a.id));
const overview=toc.find(a=>a.id.startsWith('overview'))!;const faq=toc.find(a=>/^faq|^frequently/.test(a.id))!;
const method=toc.find(a=>a.id.startsWith('methodology'))!;const profiles=toc.find(a=>/profiles/.test(a.id))!;const quick=toc.find(a=>a.id.startsWith('quick-match'))!;
const schema=[{'@type':'BlogPosting','@id':canonical+'#article',headline:post.data.title,description:post.data.description,mainEntityOfPage:canonical,inLanguage:'en',publisher:{'@id':`${publicSite}#publisher`},...(post.data.author?{author:{'@type':'Person',name:post.data.author}}:{}),...(post.data.publishedAt?{datePublished:post.data.publishedAt.toISOString()}:{}),...(post.data.updatedAt?{dateModified:post.data.updatedAt.toISOString()}:{}),image:new URL('/social.png',publicSite).href},{'@type':'BreadcrumbList',itemListElement:isHome?[{'@type':'ListItem',position:1,name:site.name,item:canonical}]:[{'@type':'ListItem',position:1,name:site.name,item:publicSite.href},{'@type':'ListItem',position:2,name:post.data.title,item:canonical}]},{'@type':'ItemList',name:post.data.title,itemListElement:ranking.agencies.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:canonical+'#'+a.id}))}];
---
<Page title={post.data.title} description={post.data.description} schema={schema} pageId={href(post.data.slug)} article>
{!isHome&&<nav aria-label="Breadcrumb"><ol class="breadcrumbs"><li><a href={withBase('/')}>{site.name}</a></li><li aria-hidden="true">/</li><li aria-current="page">{post.data.topic}</li></ol></nav>}
<article>
<header class="directory-hero" data-review-anchor="article-header">
<div class="hero-copy"><p class="eyebrow">{post.data.topic} / Agency comparison</p><h1>{post.data.title.replace(/ \(2026\)$/,'')}<span class="title-year">{post.data.sourceYear} guide</span></h1><p class="lead">{site.brief}</p><div class="hero-actions"><a class="button" href={`#${profiles.id}`}>Explore 10 agencies <Icon name="arrow-right"/></a><a class="button secondary" href={`#${overview.id}`}>Compare agencies <Icon name="arrow-up-right"/></a></div><div class="article-meta"><span><Icon name="users-three"/>10 agency profiles</span><span>{readingTime} min read</span>{post.data.updatedAt&&<time datetime={post.data.updatedAt.toISOString()}>Updated {post.data.updatedAt.toLocaleDateString('en-CA',{timeZone:'UTC'})}</time>}</div></div>
<div class="agency-roster" data-review-anchor="agency-roster"><p class="roster-label"><span>Agencies in this guide</span><span>01—10</span></p><ol class="company-grid">{ranking.agencies.map(a=><li><a href={`#${a.id}`} aria-label={`Read ${a.name}'s profile`}><CompanyMark id={a.id} name={a.name}/><span class="company-name">{a.name}</span><span class="company-number" aria-hidden="true">{a.cells[0].padStart(2,'0')}</span></a></li>)}</ol></div>
</header>
<nav class="section-tabs" aria-label="Guide sections"><a href={`#${profiles.id}`}><Icon name="users-three"/>Agency profiles</a><a href={`#${overview.id}`}>Comparison table</a><a href={`#${quick.id}`}>Quick match</a><a href={`#${method.id}`}>Methodology</a><a href={`#${faq.id}`}>FAQs</a></nav>
<div class="article-grid"><aside class="toc" aria-label="Article contents" data-review-anchor="contents"><h2><Icon name="list-bullets"/>In this guide</h2><ol>{toc.map(h=><li><a href={`#${h.id}`}>{h.label.replace(/:.*$/,'')}</a></li>)}</ol><div class="methodology-note"><strong>Look beyond the rank.</strong><p>Compare relevant work, scope, budget and the fit for your project.</p><a href={`#${method.id}`}>Read the methodology ↗</a></div><a class="back-top" href="#top">Back to top ↑</a></aside><div class="prose" data-source-article={post.data.slug}><Content/></div></div>
</article>
{related.length>0&&<section class="section article-end" aria-label="Related guides" data-review-anchor="related-guides"><div class="section-head"><h2>Explore another specialism.</h2><a class="inline-link" href={withBase('/blog/')}>All comparisons ↗</a></div><div class="guide-grid">{related.map((p,i)=><GuideCard post={p} index={i}/>)}</div></section>}
</Page>
