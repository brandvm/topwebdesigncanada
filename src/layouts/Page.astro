---
import {withBase,articles,href} from '../lib/content';
import site from '../data/site.json';
import BrandLogo from '../components/BrandLogo.astro';
import Icon from '../components/Icon.astro';
import '../styles/site.css';
import displayFont from '../assets/fonts/manrope.woff2?url';
import bodyFont from '../assets/fonts/dm-sans.woff2?url';
interface Props{title?:string;seoTitle?:string;description?:string;schema?:unknown[];pageId?:string;article?:boolean}
const {title=site.name,seoTitle=title===site.name?title:`${title} | ${site.name}`,description=site.description,schema=[]}=Astro.props;
const activePosts=await articles();const primary=activePosts.find(p=>p.data.slug===site.homeArticle);const primarySource=primary?(await import('../../docs/content-manifest.json')).default.articles.find(a=>a.slug===primary.data.slug):undefined;const methodology=primarySource?.anchors.find(a=>a.id.startsWith('methodology'))?.id;
const staging=import.meta.env.DEPLOY_ENV==='staging';
const publicSite=new URL('https://'+site.domain+'/');
const route=Astro.url.pathname.replace(import.meta.env.BASE_URL,'/');
const canonical=new URL(route,publicSite).href;
const publisher={'@type':'Organization','@id':`${publicSite}#publisher`,name:site.name,url:publicSite.href,logo:new URL('/android-chrome-512x512.png',publicSite).href};
const graph=[publisher,{'@type':'WebSite','@id':`${publicSite}#website`,name:site.name,url:publicSite.href,publisher:{'@id':publisher['@id']}},...schema];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="build-revision" content={import.meta.env.BUILD_COMMIT||'local'}/><meta name="theme-color" content={site.bg}/><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous"/><title>{seoTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{!staging&&<link rel="describedby" href={withBase("/llms.txt")} type="text/plain"/>}<link rel="icon" href={withBase("/favicon.ico")} sizes="any"/><link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml"/><link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} sizes="180x180"/><link rel="manifest" href={withBase("/site.webmanifest")}/><meta property="og:title" content={seoTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={Astro.props.article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social.png',publicSite).href}/><meta property="og:site_name" content={site.name}/><meta name="twitter:card" content="summary_large_image"/>{staging&&<meta name="robots" content="noindex,nofollow"/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head><body id="top" class="publication-canada" >
<a href="#main" class="skip">Skip to content</a><div class="wrap"><header class="site-header" data-review-anchor="header"><a class="brand" href={withBase("/")} aria-label={`${site.name} home`}><BrandLogo/></a><nav class="nav" aria-label="Main navigation">{site.navigation.filter(n=>activePosts.some(p=>p.data.slug===n.slug)).map(n=><a href={href(n.slug)} aria-current={route===href(n.slug)?'page':undefined}>{n.label}</a>)}{methodology&&<a class="nav-guide" href={withBase('/#'+methodology)}>How we compare <Icon name="arrow-up-right"/></a>}</nav></header><main id="main"><slot/></main><footer class="site-footer" data-review-anchor="footer"><div><strong>{site.name}</strong><p>{site.description}</p><p>© {new Date().getFullYear()} {site.name}</p></div><nav class="footer-nav" aria-label="Footer navigation"><a href={withBase("/")}>Home</a><a href={withBase("/blog/")}>All comparisons</a><a href="#top">Back to top ↑</a></nav></footer></div>

</body></html>
